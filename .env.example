# Blogger Agent - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# REQUIRED: Anthropic API key for Claude
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OPTIONAL: Google Custom Search API credentials
# If not provided, the system will use mock data
# Get API key from: https://console.developers.google.com/
# Create Custom Search Engine: https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here
